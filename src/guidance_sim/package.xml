<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>guidance_sim</name>
  <version>0.1.0</version>
  <description>
    Two-quadcopter guidance simulation testbed for AS5570 (Principles of Guidance
    for Autonomous Vehicles, IIT Madras). Gazebo Harmonic + ArduPilot SITL, with
    engagement geometry, a library of guidance laws and lateral-acceleration
    (latax) command generation.
  </description>
  <maintainer email="aeroboys69@gmail.com">karthik</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ardupilot_gazebo</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
