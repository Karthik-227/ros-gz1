<?xml version="1.0" ?>
<!--
  Two-vehicle engagement world for guidance_sim.

  Both copters sit on an open plane with NO obstacles: the point is clean
  pursuit-evasion kinematics, not navigation. The pursuer starts at the world
  origin and the target 500 m North of it, which matches the default
  'r0 500, lam0 0' geometry of guidance_sim.offline, so an offline run and a
  flown run start from the same place.

  Ports: iris_pursuer listens on fdm_port_in 9002 (SITL instance 0 (-I 0)) and iris_target
  on 9012 (SITL instance 1 (-I 1)). sim_vehicle.py assigns from_ardupilot_port = 9002 + 10*i
  (Tools/autotest/sim_vehicle.py:1932), so the stride is 10, not 1.

  BOTH SITL instances must be launched with the SAME home. The ArduPilot
  plugin reports WorldPose (ArduPilotPlugin.cc:1833), which is world-origin
  relative, so a shared home location puts both vehicles in one common NED frame and
  their LOCAL_POSITION_NED streams can be differenced directly.
-->
<sdf version="1.9">
  <world name="engagement">
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin filename="gz-sim-navsat-system"
      name="gz::sim::systems::NavSat">
    </plugin>

    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
      <sky></sky>
    </scene>

    <!-- Must match the home location passed to BOTH sim_vehicle.py instances. -->
    <spherical_coordinates>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Large ground plane: engagements run out to a kilometre. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>4000 4000</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>4000 4000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.35 0.42 0.30 1</ambient>
            <diffuse>0.35 0.42 0.30 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <sensor name="navsat_sensor" type="navsat">
          <always_on>1</always_on>
          <update_rate>1</update_rate>
        </sensor>
      </link>
    </model>

    <!-- NED reference axes at the origin: red = North(x), green = East(y).
         Gazebo is ENU, so the plugin converts; these mark the world frame. -->
    <model name="axes">
      <static>1</static>
      <link name="link">
        <visual name="x_red">
          <cast_shadows>0</cast_shadows>
          <pose>25 0 0.1 0 0 0</pose>
          <geometry><box><size>50 0.3 0.3</size></box></geometry>
          <material>
            <ambient>1 0 0 0.8</ambient>
            <diffuse>1 0 0 0.8</diffuse>
            <emissive>1 0 0 0.8</emissive>
          </material>
        </visual>
        <visual name="y_green">
          <cast_shadows>0</cast_shadows>
          <pose>0 25 0.1 0 0 0</pose>
          <geometry><box><size>0.3 50 0.3</size></box></geometry>
          <material>
            <ambient>0 1 0 0.8</ambient>
            <diffuse>0 1 0 0.8</diffuse>
            <emissive>0 1 0 0.8</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Pursuer: world origin, SITL instance 0, FDM port 9002. -->
    <include>
      <uri>model://iris_pursuer</uri>
      <name>iris_pursuer</name>
      <pose degrees="true">0 0 0.195 0 0 0</pose>
    </include>

    <!-- Target: 500 m East (Gazebo ENU x = East here), instance 1,
         FDM port 9012. -->
    <include>
      <uri>model://iris_target</uri>
      <name>iris_target</name>
      <pose degrees="true">50 0 0.195 0 0 180</pose>
    </include>

  </world>
</sdf>
